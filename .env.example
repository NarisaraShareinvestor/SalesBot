# ===== OpenAI (chat) =====
OPENAI_API_KEY=sk-...your_key_here...
OPENAI_MODEL=gpt-4o

# ===== Notifications =====
# สัญญาที่หมดภายในกี่วันถือว่า "ใกล้หมด"
EXPIRING_THRESHOLD_DAYS=60

# ===== Database (default: SQLite file backend/salesbot.db) =====
# DATABASE_URL=postgresql://user:pass@localhost:5432/salesbot

# ===== Email digest — Microsoft 365 / Outlook =====
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=you@shareinvestor.com
SMTP_PASS=your_app_password
SMTP_FROM=you@shareinvestor.com
# อีเมลปลายทางของแต่ละ AE ตั้งผ่านหน้า "ตั้งค่าอีเมลทีม" ในแอป (เก็บที่ backend/ae_emails.json)
