# SalesBot production env — copy to  data/.env  on the VPS and fill in real values.
# This file is the TEMPLATE (safe to commit). data/.env itself is gitignored.

# ===== OpenAI (chat) =====
OPENAI_API_KEY=sk-...real_key_here...
OPENAI_MODEL=gpt-4o

# ===== Microsoft Teams login (Azure app registration) =====
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
REDIRECT_URI=https://salesbot.ohmai.me/auth/microsoft/callback

# ===== Login fallback while AZURE_* is empty: company email + name + this team password =====
TEAM_PASSWORD=change_me
# SESSION_SECRET= (optional — if unset a random one is kept in data/.session_secret)

# ===== Admin (X-Admin-Token header for /api/admin/*) =====
ADMIN_TOKEN=change_me_long_random

# ===== Notifications =====
EXPIRING_THRESHOLD_DAYS=60

# ===== Email digest — Microsoft 365 / Outlook (optional) =====
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=you@shareinvestor.com
SMTP_PASS=your_app_password
SMTP_FROM=you@shareinvestor.com

# DATABASE_URL is set by docker-compose to the mounted SQLite file — do not set here.
